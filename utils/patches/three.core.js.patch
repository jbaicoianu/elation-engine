# Local patches to three.js core, applied by utils/build-three.sh before bundling.
# Ported from the patches carried in the old vendored UMD build (see git history
# of scripts/external/three/three.js). At r185:
# - serializeImage image.src fallback for assetworker image stubs (773aa5f)
# - VideoTexture null/stub video guards (61df16b-era)
# - keep ':' in animation track node names (d72138c)
# - silence PropertyBinding missing-node warning (6472d92)
# The PMREMGenerator XR patch (eee6fff) was dropped — native upstream since ~r156.
# Applies cleanly to three@0.185.1 build/three.core.js.
--- a/three.core.js
