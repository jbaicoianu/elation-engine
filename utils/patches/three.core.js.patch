+		} else if ( image.src ) {
+
+			return image.src;
+
 		} else {
 
 			warn( 'Texture: Unable to serialize Texture.' );
@@ -28619,7 +28623,7 @@
 
 		}
 
-		if ( 'requestVideoFrameCallback' in video ) {
+		if ( video && 'requestVideoFrameCallback' in video ) {
 
 			this._requestVideoFrameCallbackId = video.requestVideoFrameCallback( updateVideo );
 
